# Public setting. Export these variables in the shell for builds.
# Never place provider credentials in VITE_* variables.
# Empty endpoint + demo false = signup temporarily unavailable.
VITE_SIGNUP_ENDPOINT=
# Explicit opt-in for design review only. A configured endpoint takes precedence.
VITE_SIGNUP_DEMO=false

# Cloudflare build inputs. Set the matching values when preparing a deployment.
SD_D1_DATABASE_ID=
SD_PRODUCTION_DOMAIN=
SD_SIGNUP_ENABLED=false
SD_MAILCHIMP_SERVER=
SD_MAILCHIMP_AUDIENCE_ID=
# Build only. Choose hidden, preview, or published.
SD_EDITORIAL_MODE=hidden
# Provision MAILCHIMP_API_KEY and SIGNUP_LIMIT_KEY as Worker secrets.
